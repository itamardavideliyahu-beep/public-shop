# ============================================================================
# SECRETS CONFIGURATION EXAMPLE
# ============================================================================
# 
# ⚠️  IMPORTANT: 
# 1. Copy this file to: secrets.tfvars
# 2. Fill in your actual values
# 3. NEVER commit secrets.tfvars to Git!
#
# ============================================================================

# Azure Service Principal (for Terraform authentication)
subscription_id = "YOUR_SUBSCRIPTION_ID"
client_id       = "YOUR_CLIENT_ID"
client_secret   = "YOUR_CLIENT_SECRET"
tenant_id       = "YOUR_TENANT_ID"

# Email Configuration
# ============================================================================
# 📧 For Gmail:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Create an "App Password" (NOT your regular Gmail password!)
# 3. Use the 16-character password below
# ============================================================================

mail_username = "your-email@gmail.com"
mail_password = "xxxx xxxx xxxx xxxx"  # 👈 Gmail App Password (16 chars)
mail_server   = "smtp.gmail.com"
mail_port     = 587

# Optional: Change default sender
# mail_default_sender = "noreply@yourdomain.com"

# ============================================================================
# 📧 For SendGrid (Alternative):
# ============================================================================
# mail_server   = "smtp.sendgrid.net"
# mail_port     = 587
# mail_username = "apikey"  # Always "apikey" for SendGrid!
# mail_password = "SG.xxxxxxxxxxxxx"  # Your SendGrid API Key

# ============================================================================
# 📧 For Mailgun (Alternative):
# ============================================================================
# mail_server   = "smtp.mailgun.org"
# mail_port     = 587
# mail_username = "postmaster@your-domain.mailgun.org"
# mail_password = "your-mailgun-password"

# ============================================================================
# USAGE:
# ============================================================================
# terraform plan -var-file="secrets.tfvars"
# terraform apply -var-file="secrets.tfvars"
# ============================================================================


